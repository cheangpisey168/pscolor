# PS Color - Production Environment Configuration Template
# Copy this file to .env or set these in your hosting provider's dashboard

# Canonical Site URL (Used for sitemap.xml, canonical link tags, and Open Graph previews)
VITE_SITE_URL=https://pscolor.com

# Google Analytics 4 Measurement ID (Leave blank to disable telemetry completely)
# Example: G-XXXXXXXXXX
VITE_GA_ID=

# External Display Advertising (Optional - Keep disabled until partner network approval)
# Example: Carbon Ads / BuySellAds / EthicalAds
VITE_AD_NETWORK_ENABLED=false
VITE_AD_SCRIPT_URL=
